InheritParentConfig: true
Checks:
  - -misc-use-anonymous-namespace # Catch2 TEST_CASE expands to static functions
  - -cppcoreguidelines-avoid-non-const-global-variables # fake `.data` regions for the scanner
  - -clang-analyzer-optin.core.EnumCastOutOfRange # Catch2 internal flag enum
  - -bugprone-unchecked-optional-access # Catch2 REQUIRE(opt) guards are not understood
